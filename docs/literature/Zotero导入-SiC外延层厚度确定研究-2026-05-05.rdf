  <rdf:Description rdf:about="#li2010"><z:itemType>journalArticle</z:itemType><dc:title>Methods for Thickness Determination of SiC Homoepilayers by Using Infrared Reflectance Spectroscopy</dc:title><dc:creator>Li Zhi-Yun; Sun Ji-Wei; Zhang Yu-Ming; Zhang Yi-Men; Tang Xiao-Yan</dc:creator><dc:source>Chinese Physics Letters</dc:source><dc:date>2010</dc:date><dc:identifier>DOI 10.1088/0256-307X/27/6/068103</dc:identifier><dc:subject>SiC 外延层厚度确定研究</dc:subject><dc:description>核心已精读文献；FOD 与红外反射谱测厚方法来源。</dc:description></rdf:Description>
  <rdf:Description rdf:about="#dong2012"><z:itemType>journalArticle</z:itemType><dc:title>Characterization of 4H-SiC substrates and epilayers by Fourier transform infrared reflectance spectroscopy</dc:title><dc:creator>Dong Lin</dc:creator><dc:source>Chinese Physics B</dc:source><dc:date>2012</dc:date><dc:identifier>DOI 10.1088/1674-1056/21/4/047802</dc:identifier><dc:subject>SiC 外延层厚度确定研究</dc:subject><dc:description>核心已精读文献；Dong/TMM 介电函数和全谱拟合模型来源。</dc:description></rdf:Description>
  <rdf:Description rdf:about="#oishi2006"><z:itemType>journalArticle</z:itemType><dc:title>Simultaneous Determination of Carrier Concentration, Mobility, and Thickness of SiC Homoepilayers by Infrared Reflectance Spectroscopy</dc:title><dc:creator>Oishi et al.</dc:creator><dc:source>Japanese Journal of Applied Physics</dc:source><dc:date>2006</dc:date><dc:identifier>DOI 10.1143/JJAP.45.L1226</dc:identifier><dc:subject>SiC 外延层厚度确定研究</dc:subject><dc:description>待精读；厚度、载流子浓度、迁移率联合反演线索。</dc:description></rdf:Description>
  <rdf:Description rdf:about="#sun2023"><z:itemType>journalArticle</z:itemType><dc:title>An improved method for measuring epi-wafer thickness based on the infrared interference principle: Addressing interference quality and multiple interferences in double-layer structures</dc:title><dc:creator>Jiaxing Sun; Zhisong Li; Haojie Zhang; Jinlong Song; Tianbao Zhai</dc:creator><dc:source>Results in Physics</dc:source><dc:date>2023</dc:date><dc:identifier>DOI 10.1016/j.rinp.2023.107146</dc:identifier><dc:subject>SiC 外延层厚度确定研究</dc:subject><dc:description>待精读；频域独立厚度初值、VMD-LSP、Lomb-Scargle 和多重干涉线索。</dc:description></rdf:Description>
  <rdf:Description rdf:about="#dutta2022"><z:itemType>journalArticle</z:itemType><dc:title>Extracting film thickness and optical constants from spectrophotometric data by evolutionary optimization</dc:title><dc:creator>Rajdeep Dutta et al.</dc:creator><dc:source>PLOS ONE</dc:source><dc:date>2022</dc:date><dc:identifier>DOI 10.1371/journal.pone.0276555</dc:identifier><dc:subject>SiC 外延层厚度确定研究</dc:subject><dc:description>待精读；全局优化、非唯一反问题、厚度与光学常数联合反演。</dc:description></rdf:Description>
  <rdf:Description rdf:about="#chahal2024"><z:itemType>journalArticle</z:itemType><dc:title>Temperature dependence of the anisotropy of the infrared dielectric properties and phonon-plasmon coupling in n-doped 4H-SiC</dc:title><dc:creator>J. Chahal et al.</dc:creator><dc:source>Journal of Physics and Chemistry of Solids</dc:source><dc:date>2024</dc:date><dc:identifier>DOI 10.1016/j.jpcs.2023.111861</dc:identifier><dc:subject>SiC 外延层厚度确定研究</dc:subject><dc:description>待精读；近年 4H-SiC 介电性质、各向异性、phonon-plasmon coupling。</dc:description></rdf:Description>

  <rdf:Description rdf:about="#larruquert2011"><z:itemType>journalArticle</z:itemType><dc:title>Self-consistent optical constants of SiC thin films</dc:title><dc:creator>Larruquert et al.</dc:creator><dc:source>Journal of the Optical Society of America A</dc:source><dc:date>2011</dc:date><dc:identifier>DOI 10.1364/JOSAA.28.002340</dc:identifier><dc:subject>SiC 外延层厚度确定研究</dc:subject><dc:description>SiC 光学常数 n,k 初始数据来源；材料状态与本题外延层不完全等同。</dc:description></rdf:Description>
  <rdf:Description rdf:about="#polyanskiy2024"><z:itemType>journalArticle</z:itemType><dc:title>Refractiveindex.info database of optical constants</dc:title><dc:creator>Mikhail N. Polyanskiy</dc:creator><dc:source>Scientific Data</dc:source><dc:date>2024</dc:date><dc:identifier>DOI 10.1038/s41597-023-02898-2</dc:identifier><dc:subject>SiC 外延层厚度确定研究</dc:subject><dc:description>光学常数数据库引用；不替代原始实验文献。</dc:description></rdf:Description>
  <rdf:Description rdf:about="#troparevsky2010"><z:itemType>journalArticle</z:itemType><dc:title>Transfer-matrix formalism for the calculation of optical response in multilayer systems: from coherent to incoherent interference</dc:title><dc:creator>Troparevsky et al.</dc:creator><dc:source>Optics Express</dc:source><dc:date>2010</dc:date><dc:identifier>DOI 10.1364/OE.18.024715</dc:identifier><dc:subject>SiC 外延层厚度确定研究</dc:subject><dc:description>待精读；TMM、多层膜相干/非相干干涉理论。</dc:description></rdf:Description>
  <rdf:Description rdf:about="#randall1967"><z:itemType>journalArticle</z:itemType><dc:title>Refractive Indices of Germanium, Silicon, and Fused Quartz in the Far Infrared</dc:title><dc:creator>Randall; Rawcliffe</dc:creator><dc:source>Applied Optics</dc:source><dc:date>1967</dc:date><dc:identifier>DOI 10.1364/AO.6.001889</dc:identifier><dc:subject>SiC 外延层厚度确定研究</dc:subject><dc:description>Si 折射率背景；年代较早，需核对波段适配。</dc:description></rdf:Description>
  <rdf:Description rdf:about="#pitman2008"><z:itemType>journalArticle</z:itemType><dc:title>Optical properties of silicon carbide for astrophysical applications</dc:title><dc:creator>Pitman et al.</dc:creator><dc:source>Astronomy and Astrophysics</dc:source><dc:date>2008</dc:date><dc:identifier>DOI 10.1051/0004-6361:20078468</dc:identifier><dc:subject>SiC 外延层厚度确定研究</dc:subject><dc:description>SiC 红外光学性质和声子区背景；应用场景不同。</dc:description></rdf:Description>
  <rdf:Description rdf:about="#macmillan1992"><z:itemType>bookSection</z:itemType><dc:title>Interference Fringes in the Infrared Reflectance of 6H-SiC Films on 6H-SiC Substrates</dc:title><dc:creator>MacMillan; Choyke; Devaty</dc:creator><dc:date>1992</dc:date><dc:identifier>DOI 10.1007/978-3-642-84804-9_32</dc:identifier><dc:subject>SiC 外延层厚度确定研究</dc:subject><dc:description>SiC 同质外延红外干涉背景；6H-SiC 与题目材料可能不同。</dc:description></rdf:Description>
  <rdf:Description rdf:about="#byrnes_tmm"><z:itemType>computerProgram</z:itemType><dc:title>tmm: transfer matrix method Python package</dc:title><dc:creator>Steven J. Byrnes</dc:creator><dc:identifier><rdf:Description><rdf:type rdf:resource="http://purl.org/dc/terms/URI"/><rdf:value>https://github.com/sbyrnes321/tmm</rdf:value></rdf:Description></dc:identifier><dc:subject>SiC 外延层厚度确定研究</dc:subject><dc:description>TMM 代码实现参考；软件来源，不是本项目结果证据。</dc:description></rdf:Description>

